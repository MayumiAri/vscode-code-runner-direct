{
    "name": "code-runner-direct",
    "displayName": "Code Runner Direct",
    "description": "Run code directly in active open terminals (Enhanced fork of zardoy/vscode-terminal-code-runner)",
    "publisher": "Altias",
    "version": "1.0.0",
    "main": "./out/extension-node.js",
    "engines": {
        "vscode": "^1.63.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MayumiAri/vscode-terminal-2-code-runner.git"
    },
    "bugs": {
        "url": "https://github.com/MayumiAri/vscode-terminal-2-code-runner/issues"
    },
    "homepage": "https://github.com/MayumiAri/vscode-terminal-2-code-runner#readme",
    "author": {
        "name": "Altias",
        "url": "https://github.com/MayumiAri"
    },
    "contributors": [
        {
            "name": "zardoy",
            "url": "https://github.com/zardoy"
        }
    ],
    "license": "MIT",
    "categories": [
        "Other"
    ],
    "contributes": {
        "configuration": {
            "properties": {
                "execMap": {
                    "type": "object",
                    "markdownDescription": "Set the executor by [language id](https://code.visualstudio.com/docs/languages/identifiers), support [VSCode Variables](https://code.visualstudio.com/docs/editor/variables-reference)",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {
                        "javascript": "node ${relativeFile}",
                        "java": "cd $dir && javac $fileName && java $fileNameWithoutExt",
                        "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        "zig": "zig run ${relativeFile}",
                        "cpp": "cd $dir && g++ $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        "objective-c": "cd $dir && gcc -framework Cocoa $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        "php": "php ${relativeFile}",
                        "python": "python -u ${relativeFile}",
                        "perl": "perl ${relativeFile}",
                        "perl6": "perl6 ${relativeFile}",
                        "ruby": "ruby ${relativeFile}",
                        "go": "go run ${relativeFile}",
                        "lua": "lua ${relativeFile}",
                        "groovy": "groovy ${relativeFile}",
                        "powershell": "powershell -ExecutionPolicy ByPass -File ${relativeFile}",
                        "bat": "cmd /c ${relativeFile}",
                        "shellscript": "bash ${relativeFile}",
                        "fsharp": "fsi ${relativeFile}",
                        "csharp": "dotnet run",
                        "vbscript": "cscript //Nologo ${relativeFile}",
                        "typescript": "ts-node ${relativeFile}",
                        "coffeescript": "coffee ${relativeFile}",
                        "scala": "scala ${relativeFile}",
                        "swift": "swift ${relativeFile}",
                        "julia": "julia ${relativeFile}",
                        "crystal": "crystal ${relativeFile}",
                        "ocaml": "ocaml ${relativeFile}",
                        "r": "Rscript ${relativeFile}",
                        "applescript": "osascript ${relativeFile}",
                        "clojure": "lein exec ${relativeFile}",
                        "haxe": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
                        "rust": "cd $dir && rustc $fileName && $dir$fileNameWithoutExt",
                        "racket": "racket ${relativeFile}",
                        "scheme": "csi -script ${relativeFile}",
                        "ahk": "autohotkey ${relativeFile}",
                        "autoit": "autoit3 ${relativeFile}",
                        "dart": "dart ${relativeFile}",
                        "pascal": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
                        "d": "cd $dir && dmd $fileName && $dir$fileNameWithoutExt",
                        "haskell": "runghc ${relativeFile}",
                        "nim": "nim compile --verbosity:0 --hints:off --run ${relativeFile}",
                        "lisp": "sbcl --script ${relativeFile}",
                        "kit": "kitc --run ${relativeFile}",
                        "v": "v run ${relativeFile}",
                        "sass": "sass --style expanded ${relativeFile}",
                        "scss": "scss --style expanded ${relativeFile}",
                        "less": "cd $dir && lessc $fileName $fileNameWithoutExt.css",
                        "FortranFreeForm": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        "fortran-modern": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        "fortran_fixed-form": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        "fortran": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        "sml": "cd $dir && sml $fileName",
                        "mojo": "mojo run ${relativeFile}",
                        "erlang": "escript ${relativeFile}",
                        "spwn": "spwn build ${relativeFile}",
                        "pkl": "cd $dir && pkl eval -f yaml $fileName -o $fileNameWithoutExt.yaml",
                        "gleam": "gleam run -m $fileNameWithoutExt"
                    }
                },
                "executorMapByFileExtension": {
                    "type": "object",
                    "markdownDescription": "Set the executor by file extension",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {
                        ".cs": "cd $dir && dotnet run",
                        ".csx": "dotnet-script $fileName",
                        ".vb": "cd $dir && vbc /nologo $fileName && $dir$fileNameWithoutExt",
                        ".vbs": "cscript //Nologo",
                        ".scala": "scala",
                        ".jl": "julia",
                        ".cr": "crystal",
                        ".ml": "ocaml",
                        ".zig": "zig run",
                        ".exs": "elixir",
                        ".hx": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
                        ".rkt": "racket",
                        ".scm": "csi -script",
                        ".ahk": "autohotkey",
                        ".au3": "autoit3",
                        ".kt": "cd $dir && kotlinc $fileName -include-runtime -d $fileNameWithoutExt.jar && java -jar $fileNameWithoutExt.jar",
                        ".kts": "kotlinc -script",
                        ".dart": "dart",
                        ".pas": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
                        ".pp": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
                        ".d": "cd $dir && dmd $fileName && $dir$fileNameWithoutExt",
                        ".hs": "runhaskell",
                        ".nim": "nim compile --verbosity:0 --hints:off --run",
                        ".csproj": "dotnet run --project",
                        ".fsproj": "dotnet run --project",
                        ".lisp": "sbcl --script",
                        ".kit": "kitc --run",
                        ".v": "v run",
                        ".vsh": "v run",
                        ".sass": "sass --style expanded",
                        ".cu": "cd $dir && nvcc $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
                        ".ring": "ring",
                        ".sml": "cd $dir && sml $fileName",
                        ".mojo": "mojo run",
                        ".erl": "escript",
                        ".spwn": "spwn build",
                        ".pkl": "cd $dir && pkl eval -f yaml $fileName -o $fileNameWithoutExt.yaml",
                        ".gleam": "gleam run -m $fileNameWithoutExt"
                    }
                },
                "executorMapByGlob": {
                    "type": "object",
                    "markdownDescription": "Set the executor by globs",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {
                        "*.csx": "dotnet-script",
                        "pom.xml": "cd $dir && mvn clean package"
                    }
                },
                "code-runner.executorMap": {
                    "type": "object",
                    "markdownDescription": "Code Runner compatibility property for language executors",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "code-runner.executorMapByFileExtension": {
                    "type": "object",
                    "markdownDescription": "Code Runner compatibility property for file extension executors",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "code-runner.executorMapByGlob": {
                    "type": "object",
                    "markdownDescription": "Code Runner compatibility property for glob executors",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "defaultExec": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "terminalCwd": {
                    "type": "string",
                    "enum": [
                        "workspace",
                        "file"
                    ],
                    "default": "workspace"
                },
                "focusOnEditor": {
                    "type": "boolean",
                    "description": "Focus on editor whenever the file is run instead of terminal",
                    "default": false
                },
                "clearTerminal": {
                    "type": "boolean",
                    "description": "Whether to clear previous output before each run.",
                    "default": false
                },
                "saveFile": {
                    "type": "string",
                    "enum": [
                        "disabled",
                        "onlyActive",
                        "all"
                    ],
                    "default": "onlyActive"
                },
                "executeInTerminal": {
                    "type": "string",
                    "enum": [
                        "active",
                        "shared",
                        "file"
                    ],
                    "enumDescriptions": [
                        "Use current active terminal, or create one if none exists",
                        "Use shared extension terminal for different files",
                        "Use different terminals for each file"
                    ],
                    "description": "Which terminal to use to run file",
                    "default": "active"
                }
            }
        },
        "commands": [
            {
                "command": "code-runner-direct.runFile",
                "title": "Run File",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "code-runner-direct.runButton || terminal-2-code-runner.runButton || terminal-code-runner.runButton",
                    "group": "navigation@-1",
                    "command": "code-runner-direct.runFile"
                }
            ]
        }
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "Running arbitrary code available only in trusted workspaces"
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "This extension requires access to the terminal"
        }
    },
    "scripts": {
        "start": "vscode-framework start",
        "build": "tsc && vscode-framework build",
        "lint": "eslint src/**"
    },
    "devDependencies": {
        "@types/node": "^17.0.5",
        "@types/vscode": "^1.63.1",
        "@zardoy/tsconfig": "^1.2.2",
        "eslint": "^8.6.0",
        "eslint-config-zardoy": "^0.2.4",
        "typescript": "^4.9.5"
    },
    "dependencies": {
        "@zardoy/vscode-utils": "^0.0.48",
        "vscode-framework": "^0.0.18"
    },
    "prettier": {
        "semi": false,
        "singleQuote": true,
        "proseWrap": "never",
        "tabWidth": 4,
        "trailingComma": "all",
        "arrowParens": "avoid",
        "printWidth": 160,
        "endOfLine": "auto"
    }
}